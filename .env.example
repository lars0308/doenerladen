# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real tokens.

# From https://www.sanity.io/manage → your project → Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: only needed to preview draft/unpublished content.
# Create under Settings → API → Tokens → "Viewer" permission.
SANITY_API_READ_TOKEN=

# Only needed to run `npm run seed` once, to fill a fresh project with
# the site's current content. Create under Settings → API → Tokens →
# "Editor" permission. Not needed for normal operation — safe to leave
# empty, or remove the token again from Sanity afterwards.
SANITY_API_WRITE_TOKEN=

# The site's public URL, used for sitemap/canonical links/JSON-LD.
# Defaults to the Vercel URL if not set.
NEXT_PUBLIC_SITE_URL=https://doenerladen.vercel.app
